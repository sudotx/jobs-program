# Optional explicit treasury wallet (defaults to admin wallet if omitted)
TREASURY_PUBKEY=<treasury_pubkey>

# Protocol staking token mint (required for staking flows)
STAKING_TOKEN_MINT=<protocol_token_mint>

# Comma-separated stablecoin payment mints allowed for jobs (required for job creation)
PAYMENT_MINTS=<usdc_mint>,<usdt_mint>

# Optional comma-separated arbiter wallets
ARBITERS=<arbiter1>,<arbiter2>

# Platform config
FEE_BPS=500
DEFAULT_LIEN_TIMEOUT_SLOTS=648000
FORCE_RESOLUTION_FREELANCER_SHARE_BPS=5000
MIN_PROVIDER_STAKE_FOR_ACCEPT=0
MIN_PROVIDER_AGE_SLOTS_FOR_ACCEPT=0
MIN_REPUTATION_JOB_AMOUNT=0
DISPUTE_SLASHING_ENABLED=false
DISPUTE_SLASH_BPS=0
PAUSED=false
